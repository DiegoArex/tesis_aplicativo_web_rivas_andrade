    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6">
                <i class="fas fa-exclamation-circle me-3"></i>
                <span th:text="${titulo}">Auditoría de Reportes - Novedades</span>
            </h1>
            <p class="text-muted">Registro detallado de todos los reportes de incidentes: quién reportó, cuándo, descripción, prioridad y resolución</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/web/auditoria" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i> Volver
            </a>
            <button id="btnExportar" class="btn btn-success">
                <i class="fas fa-file-excel me-2"></i> Descargar Excel
            </button>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4" th:if="${novedades.size() > 0}">
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" th:text="${novedades.size()}">0</div>
                <div class="stats-label">Total Reportes</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="pendientes">0</div>
                <div class="stats-label">Pendientes</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="enProceso">0</div>
                <div class="stats-label">En Proceso</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="solucionadas">0</div>
                <div class="stats-label">Solucionadas</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="criticas">0</div>
                <div class="stats-label">Críticas</div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-section">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filtroEstado" class="form-label">
                    <i class="fas fa-filter me-2"></i> Estado
                </label>
                <select class="form-select" id="filtroEstado">
                    <option value="">Todos</option>
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="EN_PROCESO">En Proceso</option>
                    <option value="SOLUCIONADA">Solucionada</option>
                    <option value="CERRADA">Cerrada</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroPrioridad" class="form-label">
                    <i class="fas fa-exclamation-triangle me-2"></i> Prioridad
                </label>
                <select class="form-select" id="filtroPrioridad">
                    <option value="">Todas</option>
                    <option value="BAJA">Baja</option>
                    <option value="MEDIA">Media</option>
                    <option value="ALTA">Alta</option>
                    <option value="CRITICA">Crítica</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroTipo" class="form-label">
                    <i class="fas fa-tag me-2"></i> Tipo
                </label>
                <select class="form-select" id="filtroTipo">
                    <option value="">Todos</option>
                    <option value="EQUIPO">Equipo</option>
                    <option value="GENERAL">General</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <button class="btn btn-filtrar w-100" onclick="aplicarFiltros()">
                    <i class="fas fa-filter me-2"></i> Aplicar Filtros
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla Principal -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-table me-2"></i> Reportes de Incidentes - Novedades
            </h5>
        </div>
        <div class="card-body p-0">
            <div th:if="${novedades.isEmpty()}" class="no-data">
                <i class="fas fa-inbox fa-3x mb-3" style="color: #ccc;"></i>
                <p>No hay reportes de novedades disponibles.</p>
            </div>

            <div th:if="${!novedades.isEmpty()}" class="table-responsive">
                <table id="tablanovedades" class="table table-hover table-striped mb-0" style="font-size: 0.78rem;">
                    <thead class="table-dark">
                    <tr>
                        <th>Fecha Reporte</th>
                        <th>Usuario Reporta</th>
                        <th>Título</th>
                        <th>Descripción</th>
                        <th>Laboratorio</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Estado Actual</th>
                        <th>Fecha Resolución</th>
                        <th>Observaciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="novedad : ${novedades}" class="fila-novedad"
                        th:classappend="${'estado-' + novedad.estado}"
                        th:data-estado="${novedad.estado}"
                        th:data-prioridad="${novedad.prioridad}"
                        th:data-tipo="${novedad.tipo}">
                        
                        <!-- Fecha Reporte -->
                        <td th:text="${#temporals.format(novedad.fechaReporte, 'dd/MM/yyyy HH:mm:ss')}">
                            dd/MM/yyyy HH:mm:ss
                        </td>

                        <!-- Usuario Reporta -->
                        <td>
                            <strong th:text="${novedad.usuarioReporta.getNombreCompleto()}">Usuario</strong>
                            <br/>
                            <small class="text-muted" th:text="${'(' + novedad.usuarioReporta.getUsername() + ')'}">username</small>
                        </td>

                        <!-- Título -->
                        <td>
                            <strong th:text="${novedad.titulo}">Título</strong>
                        </td>

                        <!-- Descripción -->
                        <td>
                            <span th:if="${novedad.descripcion}" th:text="${#strings.abbreviate(novedad.descripcion, 80)}">Descripción</span>
                            <span th:if="!${novedad.descripcion}" class="text-muted">-</span>
                        </td>

                        <!-- Laboratorio -->
                        <td th:text="${novedad.laboratorio != null ? novedad.laboratorio.getNombre() : '-'}">
                            Laboratorio
                        </td>

                        <!-- Tipo -->
                        <td>
                            <span class="badge" 
                                th:classappend="${novedad.tipo == 'EQUIPO' ? 'badge-tipo-equipo' : 'badge-tipo-general'}">
                                <i th:class="${novedad.tipo == 'EQUIPO' ? 'fas fa-tools me-1' : 'fas fa-building me-1'}"></i>
                                <span th:text="${novedad.tipo}">Tipo</span>
                            </span>
                        </td>

                        <!-- Prioridad -->
                        <td>
                            <span class="badge" 
                                th:classappend="${'badge-prioridad-' + novedad.prioridad.toLowerCase()}">
                                <i class="fas fa-flag me-1"></i>
                                <span th:text="${novedad.prioridad}">Prioridad</span>
                            </span>
                        </td>

                        <!-- Estado Actual -->
                        <td>
                            <span class="badge" 
                                th:classappend="${'badge-estado-' + novedad.estado.toString().toLowerCase()}">
                                <i class="fas fa-check-circle me-1"></i>
                                <span th:text="${novedad.estado}">Estado</span>
                            </span>
                        </td>

                        <!-- Fecha Resolución -->
                        <td>
                            <span th:if="${novedad.fechaResolucion}" th:text="${#temporals.format(novedad.fechaResolucion, 'dd/MM/yyyy HH:mm:ss')}">
                                dd/MM/yyyy HH:mm:ss
                            </span>
                            <span th:if="!${novedad.fechaResolucion}" class="text-muted">-</span>
                        </td>

                        <!-- Quién Solucionó / Observaciones de Resolución -->
                        <td>
                            <div th:if="${novedad.observacionesResolucion}">
                                <strong>Resolución:</strong>
                                <p class="mb-0 small" th:text="${#strings.abbreviate(novedad.observacionesResolucion, 100)}">Observaciones</p>
                                <small class="text-muted" th:if="${novedad.fechaResolucion}">
                                    <i class="fas fa-clock me-1"></i>
                                    <span th:text="${#temporals.format(novedad.fechaResolucion, 'dd/MM/yyyy')}">Fecha</span>
                                </small>
                            </div>
                            <span th:if="!${novedad.observacionesResolucion}" class="text-muted">-</span>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script>
    // Inicializar DataTable
    let dataTable = null;

    $(document).ready(function() {
        // Inicializar DataTables
        dataTable = $('table.table').DataTable({
            pageLength: 10,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            autoWidth: false,
            responsive: true,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            columnDefs: [
                { responsivePriority: 1, targets: 0 },
                { responsivePriority: 2, targets: -1 }
            ]
        });
        console.log('✓ DataTable inicializado con 10 filas por página');
        
        calcularEstadisticas();
    });

    function calcularEstadisticas() {
        const filas = document.querySelectorAll('.fila-novedad');
        let pendientes = 0, enProceso = 0, solucionadas = 0, criticas = 0;

        filas.forEach(fila => {
            // Usar los atributos data-* para obtener valores precisos
            const estado = fila.getAttribute('data-estado');
            const prioridad = fila.getAttribute('data-prioridad');

            // Contar por estado
            if (estado === 'PENDIENTE') pendientes++;
            if (estado === 'EN_PROCESO') enProceso++;
            if (estado === 'SOLUCIONADA') solucionadas++;

            // Contar críticas
            if (prioridad === 'CRITICA') criticas++;
        });

        // Actualizar los valores en el DOM
        const eleId = document.getElementById('pendientes');
        const enProcesoId = document.getElementById('enProceso');
        const solucionadasId = document.getElementById('solucionadas');
        const criticasId = document.getElementById('criticas');

        if (eleId) eleId.textContent = pendientes;
        if (enProcesoId) enProcesoId.textContent = enProceso;
        if (solucionadasId) solucionadasId.textContent = solucionadas;
        if (criticasId) criticasId.textContent = criticas;

        console.log(`✓ Estadísticas calculadas: Pendientes=${pendientes}, En Proceso=${enProceso}, Solucionadas=${solucionadas}, Críticas=${criticas}`);
    }

    function aplicarFiltros() {
        const estado = document.getElementById('filtroEstado').value;
        const prioridad = document.getElementById('filtroPrioridad').value;
        const tipo = document.getElementById('filtroTipo').value;

        const filas = document.querySelectorAll('.fila-novedad');
        let visibles = 0;

        filas.forEach(fila => {
            let mostrar = true;

            // Usar atributos data-* para filtrar
            const dataEstado = fila.getAttribute('data-estado');
            const dataPrioridad = fila.getAttribute('data-prioridad');
            const dataTipo = fila.getAttribute('data-tipo');

            // Filtrar por estado
            if (estado && dataEstado !== estado) {
                mostrar = false;
            }

            // Filtrar por prioridad
            if (prioridad && dataPrioridad !== prioridad) {
                mostrar = false;
            }

            // Filtrar por tipo
            if (tipo && dataTipo !== tipo) {
                mostrar = false;
            }

            fila.style.display = mostrar ? '' : 'none';
            if (mostrar) visibles++;
        });

        console.log(`✓ Filtros aplicados: ${visibles} filas visibles`);
    }

    function descargarExcel() {
        console.log('📥 Iniciando descarga de Excel...');
        
        try {
            const url = '/web/auditoria/novedades/descargar';
            console.log('✓ Descargando desde:', url);
            
            const link = document.createElement('a');
            link.href = url;
            link.download = 'auditoria_novedades.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            console.log('✓✓✓ Excel descargado exitosamente');
            
        } catch (error) {
            console.error('❌ Error al descargar Excel:', error);
            alert('❌ Error al descargar el archivo:\n' + error.message);
        }
    }

    // Event listener para botón descargar
    document.addEventListener('DOMContentLoaded', function() {
        const btnExportar = document.getElementById('btnExportar');
        if (btnExportar) {
            btnExportar.addEventListener('click', descargarExcel);
        }
    });
</script>

</body>
</html>
</file>

