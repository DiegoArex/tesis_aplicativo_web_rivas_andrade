            <a href="/web/laboratorios" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div th:if="${error}" class="alert alert-danger" role="alert">
            <span th:text="${error}"></span>
        </div>

        <form th:action="${laboratorioId} != null ? @{/web/laboratorios/{id}/editar(id=${laboratorioId})} : @{/web/laboratorios}" th:object="${laboratorio}" method="post">
