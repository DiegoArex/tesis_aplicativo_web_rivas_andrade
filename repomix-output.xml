        </div>
        <div class="col-md-4 text-end">
            <a href="/web/auditoria" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i> Volver
            </a>
            <button id="btnExportar" class="btn btn-success">
                <i class="fas fa-file-excel me-2"></i> Descargar Excel
            </button>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4" th:if="${novedades.size() > 0}">
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" th:text="${novedades.size()}">0</div>
                <div class="stats-label">Total Reportes</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="pendientes">0</div>
                <div class="stats-label">Pendientes</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="enProceso">0</div>
                <div class="stats-label">En Proceso</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="solucionadas">0</div>
                <div class="stats-label">Solucionadas</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stats-card">
                <div class="stats-number" id="criticas">0</div>
                <div class="stats-label">Críticas</div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
