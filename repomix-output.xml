                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link active" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <!-- Header -->
        <div class="mb-4">
            <h2><i class="fas fa-history me-2"></i>Auditoría del Sistema</h2>
            <p class="text-muted">Registro detallado de todos los cambios realizados en el sistema</p>

        </div>

        <!-- Alert Informativo -->
        <div class="alert alert-info border-0 shadow-sm">
            <div class="d-flex align-items-start">
                <i class="fas fa-info-circle me-3 mt-1" style="color: #0c63e4; font-size: 1.25rem;"></i>
                <div>
                    <strong>Información de Auditoría</strong>
                    <p class="mb-0 mt-2">Registro completo de creaciones, modificaciones y eliminaciones de registros. Incluye usuario responsable, fecha/hora exacta, dirección IP y detalles de los cambios realizados.</p>
                </div>
            </div>
        </div>

        <!-- Navegación entre vistas de auditoría -->
        <ul class="nav nav-tabs mb-4" role="tablist" style="border-bottom: 2px solid #e3e6f0;">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="auditoria-general-tab" data-bs-toggle="tab" data-bs-target="#auditoria-general" 
                        type="button" role="tab" aria-controls="auditoria-general" aria-selected="true">
                    <i class="fas fa-history me-2"></i>Auditoría General
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="auditoria-usuario-tab" data-bs-toggle="tab" data-bs-target="#auditoria-usuario" 
                        type="button" role="tab" aria-controls="auditoria-usuario" aria-selected="false">
                    <i class="fas fa-user-check me-2"></i>Auditoría por Usuario
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="/web/auditoria/uso-laboratorios" 
                   title="Ver detalles de uso de laboratorios: salas, horarios entrada/salida, clases y novedades">
                    <i class="fas fa-flask me-2"></i>Uso de Laboratorios
                </a>
            </li>
        </ul>

        <!-- Filtros y Acciones -->
        <div class="row mb-4">
            <div class="col-md-6">
                <input type="text" id="filtroTabla" class="form-control form-control-sm" 
                       placeholder="🔍 Filtrar por usuario, entidad, tipo, etc..." 
                       style="font-size: 0.95rem;">
            </div>
            <div class="col-md-6 text-end">
                <a href="/web/auditoria/descargar" class="btn btn-success btn-sm" title="Descargar registros en Excel para reportería">
                    <i class="fas fa-download me-2"></i>Descargar Excel
                </a>
                <a href="/web/auditoria/uso-laboratorios" class="btn btn-info btn-sm" title="Ver auditoría de uso de laboratorios con horarios y clases">
                    <i class="fas fa-flask me-1"></i>Uso de Labs
                </a>
                <a href="/web/auditoria/novedades" class="btn btn-primary btn-sm" title="Ver reporte de novedades/incidentes reportadas">
                    <i class="fas fa-exclamation-circle me-1"></i>Por Novedad
                </a>
                <button class="btn btn-secondary btn-sm" onclick="location.reload();" title="Refrescar datos">
                    <i class="fas fa-sync-alt me-1"></i>Refrescar
                </button>
            </div>
        </div>

        <!-- Estadísticas -->
        <div class="row mb-4" th:if="${registros != null && !registros.isEmpty()}">
            <div class="col-md-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-plus-circle text-success" style="font-size: 1.5rem;"></i>
                        <h6 class="card-title mt-2">Creados</h6>
                        <p class="card-text h5 text-success countAdd">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-edit text-warning" style="font-size: 1.5rem;"></i>
                        <h6 class="card-title mt-2">Modificados</h6>
                        <p class="card-text h5 text-warning countMod">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-trash text-danger" style="font-size: 1.5rem;"></i>
                        <h6 class="card-title mt-2">Eliminados</h6>
                        <p class="card-text h5 text-danger countDel">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-database text-primary" style="font-size: 1.5rem;"></i>
                        <h6 class="card-title mt-2">Total</h6>
                        <p class="card-text h5 text-primary" th:text="${#lists.size(registros)}">0</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Auditoría -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-server me-2"></i>Historial Detallado de Cambios
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-auditoria mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 12%;">
                                    <i class="fas fa-calendar-alt"></i> Fecha/Hora
                                </th>
                                <th style="width: 12%;">
                                    <i class="fas fa-user"></i> Usuario
                                </th>
                                <th style="width: 10%;">
                                    <i class="fas fa-cube"></i> Entidad
                                </th>
                                <th style="width: 10%;">
                                    <i class="fas fa-exchange-alt"></i> Acción
                                </th>
                                <th style="width: 30%;">
                                    <i class="fas fa-file-alt"></i> Detalles
                                </th>
                                <th style="width: 12%;">
                                    <i class="fas fa-shield-alt"></i> IP
                                </th>
                                <th style="width: 14%;">
                                    <i class="fas fa-info-circle"></i> Más Info
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Sin registros -->
                            <tr th:if="${registros == null || registros.isEmpty()}">
                                <td colspan="7" class="text-center py-5">
                                    <i class="fas fa-inbox text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                                    <p class="mt-3 text-muted">
                                        <strong>Sin registros de auditoría</strong><br>
                                        <small>Los cambios realizados en el sistema aparecerán aquí automáticamente</small>
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Registros -->
                            <tr th:each="registro : ${registros}" 
                                th:classappend="${registro.accion == 'ADD' ? 'auditoria-row-insert' : registro.accion == 'MOD' ? 'auditoria-row-update' : 'auditoria-row-delete'}">
                                
                                <!-- Fecha y Hora -->
                                <td class="fecha-badge">
                                    <div th:text="${#temporals.format(registro.fechaCambio, 'dd/MM/yyyy')}">-</div>
                                    <small class="text-muted" th:text="${#temporals.format(registro.fechaCambio, 'HH:mm:ss')}">-</small>
                                </td>
                                
                                <!-- Usuario -->
                                <td>
                                    <span class="usuario-badge" th:text="${registro.usuario != null ? registro.usuario : 'SISTEMA'}">-</span>
                                </td>
                                
                                <!-- Tipo de Entidad -->
                                <td>
                                    <span class="badge" 
                                          th:classappend="${registro.tipoEntidad == 'Usuario' ? 'bg-primary' : registro.tipoEntidad == 'Equipo' ? 'bg-info' : registro.tipoEntidad == 'Laboratorio' ? 'bg-secondary' : 'bg-dark'}">
                                        <i class="fas" 
                                           th:classappend="${registro.tipoEntidad == 'Usuario' ? 'fa-user' : registro.tipoEntidad == 'Equipo' ? 'fa-desktop' : 'fa-building'}"></i>
                                        <span th:text="${registro.tipoEntidad}">-</span>
                                    </span>
                                </td>
                                
                                <!-- Acción -->
                                <td>
                                    <span class="badge" 
                                          th:classappend="${registro.accion == 'ADD' ? 'badge-insert' : registro.accion == 'MOD' ? 'badge-update' : 'badge-delete'}">
                                        <i class="fas" 
                                           th:classappend="${registro.accion == 'ADD' ? 'fa-plus me-1' : registro.accion == 'MOD' ? 'fa-pencil-alt me-1' : 'fa-trash me-1'}"></i>
                                        <span th:text="${registro.descripcionAccion}">-</span>
                                    </span>
                                </td>
                                
                                <!-- Detalles (Nombre + Descripción) -->
                                <td class="detalles-cell">
                                    <div>
                                        <strong th:text="${registro.nombreEntidad != null ? registro.nombreEntidad : 'N/A'}">-</strong>
                                    </div>
                                    <small th:text="${registro.detalles}">-</small>
                                </td>
                                
                                <!-- IP Address -->
                                <td>
                                    <code class="ip-badge" th:text="${registro.ipAddress != null ? registro.ipAddress : 'N/A'}">-</code>
                                </td>
                                
                                <!-- Más Info (ID) -->
                                <td>
                                    <small>
                                        <span class="badge bg-light text-dark">ID: <span th:text="${registro.idEntidad}">-</span></span>
                                        <br>
                                        <span class="badge bg-light text-dark mt-1">Rev: <span th:text="${registro.revisionId}">-</span></span>
                                    </small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Leyenda -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <h6 class="card-title mb-3"><i class="fas fa-legend"></i> Leyenda de Colores</h6>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="p-2 rounded mb-2" style="background-color: #d4edda; border-left: 4px solid #198754;">
                                    <span class="badge badge-insert">Creado</span> - Nuevo registro insertado
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-2 rounded mb-2" style="background-color: #fff3cd; border-left: 4px solid #ffc107;">
                                    <span class="badge badge-update">Modificado</span> - Registro actualizado
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-2 rounded mb-2" style="background-color: #f8d7da; border-left: 4px solid #dc3545;">
                                    <span class="badge badge-delete">Eliminado</span> - Registro eliminado
                                </div>
                            </div>
                            <div class="col-md-3">
                                <p class="text-muted small mb-0">
                                    <i class="fas fa-info-circle"></i> Se registran automáticamente por usuario y fecha
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script>
        // Calcular estadísticas
        document.addEventListener('DOMContentLoaded', function() {
            const filas = document.querySelectorAll('.table-auditoria tbody tr:not(:has(td[colspan]))');
            let countAdd = 0, countMod = 0, countDel = 0;
            
            filas.forEach(fila => {
                const texto = fila.textContent.toLowerCase();
                if (texto.includes('creado')) countAdd++;
                else if (texto.includes('modificado')) countMod++;
                else if (texto.includes('eliminado')) countDel++;
            });
            
            document.querySelector('.countAdd').textContent = countAdd;
            document.querySelector('.countMod').textContent = countMod;
            document.querySelector('.countDel').textContent = countDel;
        });
        
        // Filtrado en tiempo real de la tabla
        document.getElementById('filtroTabla').addEventListener('keyup', function() {
            const filtro = this.value.toLowerCase();
            const filas = document.querySelectorAll('.table-auditoria tbody tr');
            
            filas.forEach(fila => {
                if (fila.textContent.toLowerCase().includes(filtro)) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        });

        // Inicializar DataTable
        $(document).ready(function() {
            $('table.table-auditoria').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: false,  // Desactivar búsqueda de DataTables (usar el filtro manual)
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                }
            });
            console.log('✓ DataTable inicializado en Auditoría (10 filas por página)');
        });
    </script>
</body>
</html>
</file>

<file path="src/main/resources/templates/equipos/lista.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipos - Sistema de Laboratorios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
</head>
<body class="bg-light">
<!-- Navbar Principal -->
<nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <!-- Primera sección: Logo y usuario -->
    <div class="container-fluid">
        <a class="navbar-brand" href="/web/dashboard">
            <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
        </a>
        <div class="ms-auto d-flex align-items-center">
            <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
            <form th:action="@{/logout}" method="post" class="d-inline">
                <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
            </form>
        </div>
    </div>
</nav>

<!-- Segunda sección: Navegación -->
<nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                <li class="nav-item"><a class="nav-link active" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                    <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                </li>
                <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                    <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-desktop me-2"></i>Equipos</h2>

            </div>
            <div sec:authorize="hasRole('ROLE_ADMIN')">
                <a href="/web/equipos/nuevo" class="btn btn-primary" style="border-bottom: 4px solid #1e5a96; box-shadow: 0 4px 8px rgba(30, 90, 150, 0.25);">
                    <i class="fas fa-plus me-1"></i> Nuevo Equipo
                </a>
            </div>
        </div>

        <div th:if="${mensaje}" th:class="'alert alert-' + ${tipo}" role="alert">
            <span th:text="${mensaje}"></span>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white" style="background: linear-gradient(135deg, #1e5a96 0%, #0d3d66 100%) !important;">
                <i class="fas fa-list me-2"></i>Lista de Equipos
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Código</th>
                                <th>Tipo</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>N° Serie</th>
                                <th>Laboratorio</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr th:each="equipo : ${equipos}">
                                <td th:text="${equipo.id}">1</td>
                                <td>
                                    <i class="fas fa-desktop me-1" style="color: #1e5a96;"></i>
                                    <span th:text="${equipo.codigo}">EQ-001</span>
                                </td>
                                <td th:text="${equipo.tipo}">Tipo</td>
                                <td th:text="${equipo.marca}">Marca</td>
                                <td th:text="${equipo.modelo}">Modelo</td>
                                <td>
                                    <code th:text="${equipo.numeroSerie}">NS123</code>
                                </td>
                                <td>
                                    <span class="badge bg-primary" th:text="${equipo.laboratorioNombre}">Lab</span>
                                </td>
                                <td>
                                    <span th:if="${equipo.estado == 'OPERATIVO'}" class="badge bg-success">OPERATIVO</span>
                                    <span th:if="${equipo.estado == 'EN_MANTENIMIENTO'}" class="badge bg-warning text-dark">EN MANTENIMIENTO</span>
                                    <span th:if="${equipo.estado == 'DAÑADO'}" class="badge bg-danger">DAÑADO</span>
                                    <span th:if="${equipo.estado == 'FUERA_DE_SERVICIO'}" class="badge bg-secondary">FUERA DE SERVICIO</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a th:href="@{/web/equipos/{id}(id=${equipo.id})}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a sec:authorize="hasRole('ROLE_ADMIN')" th:href="@{/web/equipos/{id}/editar(id=${equipo.id})}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form sec:authorize="hasRole('ROLE_ADMIN')" th:action="@{/web/equipos/{id}/eliminar(id=${equipo.id})}" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar definitivamente este equipo? Esta acción no se puede deshacer.');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Eliminar definitivamente">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <tr th:if="${equipos.empty}">
                                <td colspan="8" class="text-center text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p>No hay equipos registrados</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script>
        $(document).ready(function() {
            $('table.table').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                }
            });
            console.log('✓ DataTable inicializado en Equipos (10 filas por página)');
        });
    </script>
</body>
</html>
</file>

<file path="src/main/resources/templates/novedades/lista.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo != null ? titulo + ' - Sistema de Laboratorios' : 'Novedades - Sistema de Laboratorios'}">Novedades</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
    <style>
        body { padding-top: 20px; }
        
        /* Colores para los estados en la tabla */
        tr[data-estado="SOLUCIONADA"] {
            background-color: #d4f1d4 !important;
        }
        
        tr[data-estado="PENDIENTE"] {
            background-color: #fff9e6 !important;
        }
        
        tr[data-estado="EN_PROCESO"] {
            background-color: #e0f2f7 !important;
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <!-- Primera sección: Logo y usuario -->
    <div class="container-fluid">
        <a class="navbar-brand" href="/web/dashboard">
            <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
        </a>
        <div class="ms-auto d-flex align-items-center">
            <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
            <form th:action="@{/logout}" method="post" class="d-inline">
                <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
            </form>
        </div>
    </div>
</nav>

<!-- Segunda sección: Navegación -->
<nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                    <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                </li>
                <li class="nav-item"><a class="nav-link active" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                    <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-exclamation-circle me-2"></i>Novedades</h2>
                <p class="text-muted">Gestión de reportes e incidentes</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/web/novedades/mis" class="btn btn-outline-secondary btn-sm"><i class="fas fa-user me-1"></i> Mis Novedades</a>
                <a href="/web/novedades/nueva" class="btn btn-primary btn-sm" style="border-bottom: 4px solid #1e5a96; box-shadow: 0 4px 8px rgba(30, 90, 150, 0.25);"
                   sec:authorize="hasAnyRole('ROLE_USUARIO','ROLE_PROFESOR','ROLE_FACULTAD_DIRECTOR_CARRERA','ROLE_ADMIN')">
                    <i class="fas fa-plus me-1"></i> Reportar Novedad
                </a>
            </div>
        </div>
    </div>

    <div class="container-fluid py-4">
        <!-- Flash messages -->
        <div class="container">
            <div th:if="${mensaje}" th:class="'alert alert-' + (${tipo} != null ? ${tipo} : 'info') + ' alert-dismissible fade show'" role="alert">
                <i class="fas fa-info-circle me-2"></i><span th:text="${mensaje}"></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>

            <!-- Filtros -->
            <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; align-items: center; padding: 1.5rem; background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                <span class="text-muted small fw-semibold" style="margin-right: 0.5rem;"><i class="fas fa-filter me-1"></i>Filtrar:</span>
                <a href="/web/novedades" class="btn btn-sm btn-outline-primary"><i class="fas fa-inbox me-1"></i> Todas</a>
                <a href="/web/novedades/estado/PENDIENTE" class="btn btn-sm btn-outline-secondary">🕐 Pendientes</a>
                <a href="/web/novedades/estado/EN_PROCESO" class="btn btn-sm btn-outline-info">⚙️ En Proceso</a>
                <a href="/web/novedades/estado/SOLUCIONADA" class="btn btn-sm btn-outline-success">✅ Solucionadas</a>
            </div>

        <!-- Tabla -->
        <div th:if="${novedades != null and not #lists.isEmpty(novedades)}">
            <p class="text-muted small mb-2"><i class="fas fa-list-ol me-1"></i><span th:text="${#lists.size(novedades)}">0</span> novedad(es)</p>
            <div class="table-card">
                <div class="table-responsive">
                    <table class="table table-novedades">
                        <thead>
                            <tr>
                                <th>#</th><th>Título</th><th>Tipo</th><th>Estado</th><th>Prioridad</th>
                                <th>Laboratorio</th><th>Reportado por</th><th>Fecha</th><th><i class="fas fa-image"></i></th><th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr th:each="novedad : ${novedades}" th:classappend="'border-left-' + ${novedad.prioridad}" th:attr="data-estado=${novedad.estado?.name()}">
                                <td class="text-muted small" th:text="${novedad.id}">#</td>
                                <td>
                                    <a th:href="@{/web/novedades/{id}(id=${novedad.id})}" class="novedad-titulo" th:text="${novedad.titulo}">Título</a>
                                    <div class="descripcion-truncada" th:text="${novedad.descripcion}">Desc</div>
                                </td>
                                <td><span class="badge bg-secondary" th:text="${novedad.tipo}">Tipo</span></td>
                                <td><span class="badge rounded-pill" th:classappend="'badge-estado-' + ${novedad.estado?.name()}" th:text="${novedad.estado}">Estado</span></td>
                                <td><span class="badge rounded-pill" th:classappend="'badge-prioridad-' + ${novedad.prioridad}" th:text="${novedad.prioridad}">Prior</span></td>
                                <td class="small" th:text="${novedad.laboratorioNombre != null ? novedad.laboratorioNombre : '-'}">Lab</td>
                                <td class="small" th:text="${novedad.usuarioReportaNombre != null ? novedad.usuarioReportaNombre : 'Desconocido'}">User</td>
                                <td class="small text-nowrap" th:text="${novedad.fechaReporte != null ? #temporals.format(novedad.fechaReporte, 'dd/MM/yyyy HH:mm') : '-'}">Fecha</td>
                                <td class="text-center">
                                    <span th:if="${novedad.cantidadImagenes != null and novedad.cantidadImagenes > 0}" class="badge bg-info text-white" th:text="${novedad.cantidadImagenes}">0</span>
                                    <span th:unless="${novedad.cantidadImagenes != null and novedad.cantidadImagenes > 0}" class="text-muted">—</span>
                                </td>
                                <td><a th:href="@{/web/novedades/{id}(id=${novedad.id})}" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sin resultados -->
        <div th:if="${novedades == null or #lists.isEmpty(novedades)}" class="table-card">
            <div class="empty-state">
                <i class="fas fa-inbox d-block"></i>
                <h5 class="text-muted mb-2">No hay novedades registradas</h5>
                <p class="text-muted small mb-0">Aún no se han reportado novedades o no hay resultados para el filtro seleccionado.</p>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script>
    $(document).ready(function() {
        $('table.table-novedades').DataTable({
            pageLength: 10,
            lengthChange: true,
            searching: true,
            ordering: true,
            info: true,
            autoWidth: false,
            responsive: true,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            }
        });
        console.log('✓ DataTable inicializado en Novedades (10 filas por página)');
    });
</script>
</body>
</html>
</file>

<file path="src/main/resources/templates/registros/lista.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Uso - Sistema de Laboratorios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <!-- Primera sección: Logo y usuario -->
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main">
        <div class="header-section">
            <h1><i class="fas fa-clipboard-list me-2"></i>Registros de Uso</h1>
            <div class="d-flex gap-2">
                <a href="/web/registros/entrada" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt me-1"></i> Nueva Entrada
                </a>
                <a href="/web/registros/salida" class="btn btn-outline-primary">
                    <i class="fas fa-sign-out-alt me-1"></i> Registrar Salida
                </a>
            </div>
        </div>

        <!-- Tabla de registros -->
        <div class="card">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-history me-2"></i>Historial de Registros
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Laboratorio</th>
                                <th>Usuario</th>
                                <th>Entrada</th>
                                <th>Salida</th>
                                <th>Duración</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr th:each="registro : ${registros}">
                                <td th:text="${registro.id}">1</td>
                                <td th:text="${registro.laboratorioNombre}">Laboratorio</td>
                                <td th:text="${registro.usuarioNombre}">Usuario</td>
                                <td th:text="${#temporals.format(registro.fechaEntrada, 'dd/MM/yyyy HH:mm')}">Entrada</td>
                                <td th:text="${registro.fechaSalida != null} ? ${#temporals.format(registro.fechaSalida, 'dd/MM/yyyy HH:mm')} : 'Activo'">Salida</td>
                                <td th:text="${registro.duracionFormateada}">Duración</td>
                                <td>
                                    <span th:if="${registro.activo}" class="badge bg-success">Activo</span>
                                    <span th:unless="${registro.activo}" class="badge bg-secondary">Cerrado</span>
                                </td>
                            </tr>
                            <tr th:if="${registros.empty}">
                                <td colspan="7" class="text-center text-muted">
                                    No hay registros de uso
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script>
        $(document).ready(function() {
            $('table.table').DataTable({
                pageLength: 10,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                }
            });
            console.log('✓ DataTable inicializado en Registros (10 filas por página)');
        });
    </script>
</body>
</html>
</file>

<file path="src/main/resources/templates/usuarios/detalle.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
    <style>
        body { padding-top: 20px; }
    </style>
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <!-- Primera sección: Logo y usuario -->
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main">
        <div class="header-section">
            <h1><i class="fas fa-user-circle me-2"></i>Detalle de Usuario</h1>
            <a href="/web/dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div th:if="${mensaje}" th:class="'alert alert-' + ${tipo}" role="alert">
            <span th:text="${mensaje}"></span>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="fas fa-info-circle me-2"></i>Perfil de Usuario
                    </div>
                    <div class="card-body">
                        <h3 class="mb-4 text-primary" th:text="${usuario.nombreCompleto}">Nombre</h3>
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Usuario (Username)</label>
                                <span class="fw-bold" th:text="${usuario.username}"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Correo Institucional</label>
                                <span class="fw-bold text-secondary" th:text="${usuario.email}"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Carrera / Programa</label>
                                <span class="fw-bold text-secondary" th:text="${usuario.carrera}"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Facultad</label>
                                <span class="fw-bold text-secondary" th:text="${usuario.facultad}"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Roles Asignados</label>
                                <span class="badge bg-light text-dark border" th:text="${usuario.roles}"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="text-muted small d-block">Estado de Cuenta</label>
                                <span th:if="${usuario.activo}" class="status-badge status-active">Activo</span>
                                <span th:unless="${usuario.activo}" class="status-badge status-inactive">Inactivo</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Gestión de Usuario (comentado por ahora)
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-deep-blue); color: white;">
                    <div class="card-header border-0" style="background: rgba(255,255,255,0.1);">
                        <i class="fas fa-cogs me-2"></i>Gestión de Usuario
                    </div>
                    <div class="card-body d-grid gap-3 p-4">
                        <a th:href="@{/web/usuarios/{id}/editar(id=${usuario.id})}" class="btn btn-light btn-lg">
                            <i class="fas fa-edit me-1 text-primary"></i> Editar Perfil
                        </a>
                        <form th:action="@{/web/usuarios/{id}/desactivar(id=${usuario.id})}" method="post">
                            <button type="submit" class="btn btn-outline-light w-100">
                                <i class="fas fa-user-slash me-1"></i> Desactivar Cuenta
                            </button>
                        </form>
                        <form th:action="@{/web/usuarios/{id}/eliminar(id=${usuario.id})}" method="post" onsubmit="return confirm('¿Está seguro de eliminar este usuario?')">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="fas fa-trash me-1"></i> Eliminar Definitivamente
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            -->
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
