                <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                    <a class="nav-link active" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-6">
                <i class="fas fa-flask me-3"></i>
                <span th:text="${titulo}">Auditoría de Uso de Laboratorios</span>
            </h1>
            <p class="text-muted">Registro detallado del uso de laboratorios: salas, horarios de entrada/salida, actividades y novedades reportadas</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/web/auditoria" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i> Volver
            </a>
            <button id="btnExportar" class="btn btn-success">
                <i class="fas fa-file-excel me-2"></i> Descargar Excel
            </button>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4" th:if="${auditoriaUsos.size() > 0}">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number" th:text="${auditoriaUsos.size()}">0</div>
                <div class="stats-label">Total de Sesiones</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number" id="usuariosUnicos">0</div>
                <div class="stats-label">Usuarios</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number" id="laboratoriosUnicos">0</div>
                <div class="stats-label">Laboratorios</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="stats-number" id="novedadesCount">0</div>
                <div class="stats-label">Novedades Reportadas</div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-section">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="filtroUsuario" class="form-label">
                    <i class="fas fa-user me-2"></i> Usuario
                </label>
                <input type="text" class="form-control" id="filtroUsuario" placeholder="Filtrar por usuario..."/>
            </div>
            <div class="col-md-3">
                <label for="filtroLaboratorio" class="form-label">
                    <i class="fas fa-door-open me-2"></i> Sala
                </label>
                <input type="text" class="form-control" id="filtroLaboratorio" placeholder="Filtrar por sala..."/>
            </div>
            <div class="col-md-3">
                <label for="filtroClase" class="form-label">
                    <i class="fas fa-chalkboard me-2"></i> Clase
                </label>
                <input type="text" class="form-control" id="filtroClase" placeholder="Filtrar por clase..."/>
            </div>
            <div class="col-md-3">
                <label for="filtroNovedad" class="form-label">
                    <i class="fas fa-exclamation-triangle me-2"></i> Con Novedad
                </label>
                <select class="form-select" id="filtroNovedad">
                    <option value="">Todas</option>
                    <option value="si">Sí</option>
                    <option value="no">No</option>
                </select>
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <button class="btn btn-filtrar" onclick="aplicarFiltros()">
                    <i class="fas fa-filter me-2"></i> Aplicar Filtros
                </button>
                <button class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                    <i class="fas fa-redo me-2"></i> Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla Principal - Sincronizada con Excel -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-table me-2"></i> Registros de Uso de Laboratorios (12 Columnas)
            </h5>
        </div>
        <div class="card-body p-0">
            <div th:if="${auditoriaUsos.isEmpty()}" class="no-data">
                <i class="fas fa-inbox fa-3x mb-3" style="color: #ccc;"></i>
                <p>No hay registros de uso de laboratorios disponibles.</p>
            </div>

            <div th:if="${!auditoriaUsos.isEmpty()}" class="table-responsive">
                <table id="tablausoLaboratorios" class="table table-hover table-striped mb-0" style="font-size: 0.78rem;">
                    <thead class="table-dark">
                    <tr>
                        <th>Fecha Entrada</th>
                        <th>Fecha Salida</th>
                        <th>Usuario</th>
                        <th>Nombre Completo</th>
                        <th>Laboratorio(s)</th>
                        <th>Ubicación</th>
                        <th>Propósito</th>
                        <th>Observaciones</th>
                        <th>Tipo Registro</th>
                        <th>Duración</th>
                        <th>Novedad</th>
                        <th>Estado Novedad</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="uso : ${auditoriaUsos}" class="fila-registro" 
                        th:classappend="${uso.esExamen ? 'table-warning' : ''}">
                        
                        <!-- Fecha Entrada -->
                        <td th:text="${#temporals.format(uso.horaEntrada, 'dd/MM/yyyy HH:mm:ss')}">
                            dd/MM/yyyy HH:mm:ss
                        </td>

                        <!-- Fecha Salida -->
                        <td>
                            <span th:if="${uso.horaSalida}" th:text="${#temporals.format(uso.horaSalida, 'dd/MM/yyyy HH:mm:ss')}">
                                dd/MM/yyyy HH:mm:ss
                            </span>
                            <span th:if="!${uso.horaSalida}" class="badge bg-warning text-dark">
                                <i class="fas fa-hourglass-end me-1"></i> Abierto
                            </span>
                        </td>

                        <!-- Usuario -->
                        <td th:text="${uso.usuario}">usuario</td>

                        <!-- Nombre Completo -->
                        <td th:text="${uso.nombreCompletoUsuario}">Nombre Completo</td>

                        <!-- Laboratorio(s) - Mostrar dual si es examen -->
                        <td>
                            <span th:if="${uso.esExamen}">
                                <strong th:text="${uso.nombreLaboratorio + ' y ' + uso.nombreLaboratorioSecundario}">Lab1 y Lab2</strong>
                            </span>
                            <span th:if="!${uso.esExamen}" th:text="${uso.nombreLaboratorio}">Laboratorio</span>
                        </td>

                        <!-- Ubicación -->
                        <td th:text="${uso.ubicacionLaboratorio}">Ubicación</td>

                        <!-- Propósito -->
                        <td>
                            <span th:if="${uso.proposito}" th:text="${uso.proposito}">Propósito</span>
                            <span th:if="!${uso.proposito}" class="text-muted">-</span>
                        </td>

                        <!-- Observaciones -->
                        <td>
                            <span th:if="${uso.observaciones}" th:text="${uso.observaciones}">Observaciones</span>
                            <span th:if="!${uso.observaciones}" class="text-muted">-</span>
                        </td>

                        <!-- Tipo Registro -->
                        <td>
                            <span th:if="${uso.esExamen}" class="badge bg-warning text-dark">
                                <i class="fas fa-graduation-cap me-1"></i>Examen
                            </span>
                            <span th:if="!${uso.esExamen}" class="badge bg-info">
                                <i class="fas fa-book me-1"></i>Normal
                            </span>
                        </td>

                        <!-- Duración -->
                        <td>
                            <span th:if="${uso.duracionFormatada}" th:text="${uso.duracionFormatada}">0h 0min</span>
                            <span th:if="!${uso.duracionFormatada}" class="text-muted">-</span>
                        </td>

                        <!-- Novedad -->
                        <td>
                            <span th:if="${uso.novedadId}">
                                <span class="badge" th:classappend="${uso.tipoNovedad == 'EQUIPO' ? 'bg-danger' : 'bg-secondary'}">
                                    <i class="fas fa-exclamation-circle me-1"></i>
                                    <span th:text="${uso.nombreNovedad}">Novedad</span>
                                </span>
                            </span>
                            <span th:if="!${uso.novedadId}" class="text-muted">-</span>
                        </td>

                        <!-- Estado Novedad -->
                        <td>
                            <span th:if="${uso.estadoNovedad}">
                                <span class="badge" 
                                    th:classappend="${uso.estadoNovedad == 'PENDIENTE' ? 'bg-warning text-dark' : (uso.estadoNovedad == 'EN_PROCESO' ? 'bg-info' : 'bg-success')}">
                                    <span th:text="${uso.estadoNovedad}">Estado</span>
                                </span>
                            </span>
                            <span th:if="!${uso.estadoNovedad}" class="text-muted">-</span>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('✓ DOM cargado - uso-laboratorios');
        
        // Inicializar DataTable
        const table = $('#tablausoLaboratorios').DataTable({
            responsive: true,
            paging: true,
            pageLength: 25,
            lengthChange: true,
            searching: true,
            info: true,
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            columnDefs: [
                { responsivePriority: 1, targets: 0 },
                { responsivePriority: 2, targets: -1 }
            ]
        });
        
        // Obtener referencia al botón de exportar
        const btnExportar = document.getElementById('btnExportar');
        if (btnExportar) {
            console.log('✓ Botón #btnExportar encontrado');
            btnExportar.addEventListener('click', descargarExcel);
        } else {
            console.error('❌ No se encontró el botón #btnExportar');
        }
    });

    function descargarExcel() {
        console.log('📥 Iniciando descarga de Excel desde servidor...');
        
        try {
            const url = '/web/auditoria/uso-laboratorios/descargar';
            const link = document.createElement('a');
            link.href = url;
            link.download = 'auditoria_uso_laboratorios.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            console.log('✓ Excel descargado exitosamente');
        } catch (error) {
            console.error('❌ Error al descargar Excel:', error);
            alert('❌ Error al descargar el archivo');
        }
    }
</script>

</body>
</html>
