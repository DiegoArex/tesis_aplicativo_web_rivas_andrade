<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
console.log('[OK] Script cargado');

// ── Toggle equipo + carga dinámica por AJAX ──
(function () {
    var tipoSelect   = document.getElementById('tipo');
    var equipoGroup  = document.getElementById('equipoGroup');
    var equipoSelect = document.getElementById('equipoId');
    var labSelect    = document.getElementById('laboratorioId');
    var equipoVacio  = document.getElementById('equipoVacio');

    function toggleEquipo() {
        var esEquipo = tipoSelect.value === 'EQUIPO';
        console.log('[DEBUG] Tipo:', tipoSelect.value, '-> mostrar equipo:', esEquipo);
        equipoGroup.style.display = esEquipo ? '' : 'none';
        equipoSelect.required = esEquipo;
        if (!esEquipo) {
            equipoSelect.value = '';
            limpiarEquipos();
        } else {
            cargarEquipos();
        }
    }

    function limpiarEquipos() {
        while (equipoSelect.options.length > 1) equipoSelect.remove(1);
        if (equipoVacio) equipoVacio.style.display = 'none';
    }

    function cargarEquipos() {
        var labId = labSelect.value;
        console.log('[DEBUG] Cargando equipos para lab:', labId);
        limpiarEquipos();

        if (!labId) {
            equipoSelect.options[0].textContent = '-- Seleccione primero un laboratorio --';
            return;
        }

        equipoSelect.options[0].textContent = '⏳ Cargando equipos...';

        fetch('/web/novedades/equipos/' + labId, { credentials: 'same-origin' })
            .then(function(response) {
                console.log('[DEBUG] Respuesta API:', response.status);
                if (!response.ok) throw new Error('Error ' + response.status);
                return response.json();
            })
            .then(function(equipos) {
                console.log('[DEBUG] Equipos recibidos:', equipos.length, equipos);
                equipoSelect.options[0].textContent = '-- Seleccione un equipo --';

                if (equipos.length === 0) {
                    if (equipoVacio) equipoVacio.style.display = 'block';
                    return;
                }

                for (var i = 0; i < equipos.length; i++) {
                    var eq = equipos[i];
                    var opt = document.createElement('option');
                    opt.value = eq.id;
                    opt.textContent = (eq.codigo || '?') + ' - ' + (eq.marca || '') + ' ' + (eq.modelo || '');
                    equipoSelect.add(opt);
                }
            })
            .catch(function(err) {
                console.error('[ERROR] No se pudieron cargar equipos:', err);
                equipoSelect.options[0].textContent = '-- Error al cargar equipos --';
            });
    }

    tipoSelect.addEventListener('change', toggleEquipo);
    labSelect.addEventListener('change', function() {
        console.log('[DEBUG] Lab changed:', labSelect.value);
        if (tipoSelect.value === 'EQUIPO') cargarEquipos();
    });
    toggleEquipo();
})();

// ── Imagen upload ──
function handleFileSelect(input) {
    var file = input.files[0];
    if (!file) return;
    if (['image/jpeg', 'image/png'].indexOf(file.type) === -1) {
        alert('Solo se permiten archivos JPG, JPEG o PNG.');
        input.value = ''; return;
    }
    if (file.size > 5 * 1024 * 1024) {
        alert('El archivo no debe superar los 5 MB.');
        input.value = ''; return;
    }
    var reader = new FileReader();
    reader.onload = function (e) {
        document.getElementById('previewImage').src = e.target.result;
        document.getElementById('fileName').textContent = file.name;
        document.getElementById('uploadPlaceholder').style.display = 'none';
        document.getElementById('uploadPreview').style.display = '';
        document.getElementById('uploadArea').classList.add('has-file');
    };
    reader.readAsDataURL(file);
}

function clearFile() {
    document.getElementById('archivo').value = '';
    document.getElementById('uploadPlaceholder').style.display = '';
    document.getElementById('uploadPreview').style.display = 'none';
    document.getElementById('uploadArea').classList.remove('has-file');
}
</script>
</body>
</html>
</file>

