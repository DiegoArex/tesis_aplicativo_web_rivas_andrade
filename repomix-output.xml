<body class="bg-light">
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link active" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4 mb-4">
        <div class="row">
            <div class="col-lg-12">
                <!-- Botón para volver -->
                <a href="/web/auditoria" class="btn-volver">
                    <i class="fas fa-arrow-left"></i> Volver a Auditoría
                </a>

                <!-- Información -->
                <div class="info-box">
                    <i class="fas fa-info-circle"></i>
                    <strong>Cambios Operacionales:</strong> Visualiza todos los cambios realizados sobre laboratorios, equipos y resoluciones de novedades. Puedes filtrar por tipo de entidad y descargar el reporte en Excel.
                </div>

                <!-- Tabla de Cambios -->
                <div class="tabla-container">
                    <div class="tabla-header">
                        <h3>
                            <i class="fas fa-tools"></i>
                            Registro de Cambios Operacionales
                        </h3>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="text" id="auditoria-search" class="form-control" placeholder="Buscar cambios..." style="max-width: 300px; height: 38px;">
                            <a href="/web/auditoria/cambios-operacionales/descargar" class="btn-descargar" title="Descargar en Excel">
                                <i class="fas fa-download"></i> Descargar Excel
                            </a>
                        </div>
                    </div>

                    <div class="tabla-body">
                        <table class="table table-hover table-auditoria mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 14%;">Fecha/Hora</th>
                                    <th style="width: 12%;">Usuario</th>
                                    <th style="width: 12%;">IP Address</th>
                                    <th style="width: 12%;">Tipo Entidad</th>
                                    <th style="width: 18%;">Nombre Entidad</th>
                                    <th style="width: 10%;">Acción</th>
                                    <th style="width: 20%;">Detalles</th>
                                    <th style="width: 12%;">ID Registro</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr th:each="cambio : ${cambios}" 
                                    th:class="${cambio.accion eq 'ADD' ? 'auditoria-row-insert' : (cambio.accion eq 'MOD' ? 'auditoria-row-update' : 'auditoria-row-delete')}">

                                    <!-- Fecha/Hora -->
                                    <td class="fecha-badge">
                                        <span th:if="${cambio.fechaCambio != null}" th:text="${#temporals.format(cambio.fechaCambio, 'dd/MM/yyyy HH:mm:ss')}"></span>
                                        <span th:unless="${cambio.fechaCambio != null}">-</span>
                                    </td>

                                    <!-- Usuario -->
                                    <td>
                                        <span class="usuario-badge" th:text="${cambio.usuario != null ? cambio.usuario : '-'}"></span>
                                    </td>

                                    <!-- IP Address -->
                                    <td>
                                        <span class="ip-badge" th:text="${cambio.ipAddress != null ? cambio.ipAddress : '-'}"></span>
                                    </td>

                                    <!-- Tipo Entidad -->
                                    <td>
                                        <span th:class="'tipo-entidad-badge ' + (${cambio.tipoEntidad} eq 'Laboratorio' ? 'tipo-laboratorio' : (${cambio.tipoEntidad} eq 'Equipo' ? 'tipo-equipo' : 'tipo-novedad'))"
                                              th:text="${cambio.tipoEntidad != null ? cambio.tipoEntidad : '-'}"></span>
                                    </td>

                                    <!-- Nombre Entidad -->
                                    <td>
                                        <strong th:text="${cambio.nombreEntidad != null ? cambio.nombreEntidad : '-'}"></strong>
                                    </td>

                                    <!-- Acción -->
                                    <td>
                                        <span th:class="'badge ' + (${cambio.accion} eq 'ADD' ? 'badge-insert' : (${cambio.accion} eq 'MOD' ? 'badge-update' : 'badge-delete'))"
                                              th:text="${cambio.descripcionAccion != null ? cambio.descripcionAccion : (cambio.accion != null ? cambio.accion : '-')}"></span>
                                    </td>

                                    <!-- Detalles -->
                                    <td class="detalles-cell" th:text="${cambio.detalles != null ? cambio.detalles : '-'}"></td>

                                    <!-- ID Registro -->
                                    <td>
                                        <small th:text="${cambio.idEntidad != null ? cambio.idEntidad : '-'}"></small>
                                    </td>
                                </tr>

                                <tr th:if="${#lists.isEmpty(cambios)}">
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        No hay cambios operacionales registrados
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mt-4 mb-3">
                    <small class="text-muted">
                        <i class="fas fa-square" style="color: #d4edda; margin-right: 0.5rem;"></i> Creado
                        <i class="fas fa-square" style="color: #fff3cd; margin-left: 1.5rem; margin-right: 0.5rem;"></i> Modificado
                        <i class="fas fa-square" style="color: #f8d7da; margin-left: 1.5rem; margin-right: 0.5rem;"></i> Eliminado
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar DataTable solo si existe la tabla
            if ($('.table-auditoria').length > 0) {
                var table = $('.table-auditoria').DataTable({
                    responsive: true,
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json',
                        paginate: {
                            first: '«',
                            last: '»',
                            next: '›',
                            previous: '‹'
                        }
                    },
                    order: [[0, 'desc']],
                    columnDefs: [
                        {
                            targets: 0,
                            type: 'date',
                            render: function(data, type, row) {
                                if (type === 'sort' || type === 'type') {
                                    return data;
                                }
                                return data;
                            }
                        },
                        {
                            targets: 3, // Tipo Entidad
                            searchable: true,
                            orderable: true
                        },
                        {
                            targets: 5, // Acción
                            searchable: true,
                            orderable: true
                        }
                    ],
                    dom: '<"top"lf>rt<"bottom"ip><"clear">',
                    initComplete: function() {
                        this.api().columns().every(function() {
                            var column = this;
                        });
                    }
                });
                
                // Mejorar búsqueda en tiempo real
                $('#auditoria-search').on('keyup', function() {
                    table.search(this.value).draw();
                });
            }

            // Animación de carga
            document.querySelectorAll('tbody tr').forEach(tr => {
                tr.style.animation = 'fadeIn 0.3s ease-in-out';
            });
        });
    </script>
</body>
</html>
