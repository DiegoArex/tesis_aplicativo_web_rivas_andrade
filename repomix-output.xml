                       placeholder="Ej: Pantalla del PC-03 no enciende" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label for="tipo" class="form-label fw-semibold"><i class="fas fa-tag me-1"></i>Tipo <span class="text-danger">*</span></label>
                <select id="tipo" name="tipo" class="form-select" required>
                    <option value="">-- Seleccione --</option>
                    <option value="GENERAL">🏢 GENERAL (infraestructura / limpieza)</option>
                    <option value="EQUIPO">💻 EQUIPO (problema en un equipo)</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="prioridad" class="form-label fw-semibold"><i class="fas fa-exclamation me-1"></i>Prioridad <span class="text-danger">*</span></label>
                <select id="prioridad" name="prioridad" class="form-select" required>
                    <option value="">-- Seleccione --</option>
                    <option value="BAJA">🔵 BAJA</option>
                    <option value="MEDIA">🟡 MEDIA</option>
                    <option value="ALTA">🟠 ALTA</option>
                    <option value="CRITICA">🔴 CRITICA</option>
                </select>
            </div>
            <div class="col-12">
                <label for="descripcion" class="form-label fw-semibold"><i class="fas fa-align-left me-1"></i>Descripción <span class="text-danger">*</span></label>
                <textarea id="descripcion" name="descripcion" class="form-control" rows="5"
                          placeholder="Describe el problema con el mayor detalle posible..."
                          maxlength="2000" required></textarea>
                <div class="text-end mt-1"><small class="text-muted">Máx. 2000 caracteres</small></div>
            </div>
        </div>

        <!-- ── UBICACIÓN ── -->
        <div class="section-title"><i class="fas fa-map-marker-alt me-2"></i> Ubicación</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label for="laboratorioId" class="form-label fw-semibold"><i class="fas fa-flask me-1"></i>Laboratorio <span class="text-danger">*</span></label>
                <select id="laboratorioId" name="laboratorioId" class="form-select" required>
                    <option value="">-- Seleccione un laboratorio --</option>
                    <option th:each="lab : ${laboratorios}" th:value="${lab.id}" th:text="${lab.nombre}">Lab</option>
