                           placeholder="Buscar usuario..." 
                           style="font-size: 0.95rem;">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-600 mb-2">
                        <i class="fas fa-filter me-1"></i>Filtrar por Tipo
                    </label>
                    <select id="filtroTipo" class="form-control form-control-sm" style="font-size: 0.95rem;">
                        <option value="">Todos los tipos</option>
                        <option value="NOVEDAD">Novedades Reportadas</option>
                        <option value="LABORATORIO">Laboratorios</option>
                        <option value="EQUIPO">Equipos</option>
                        <option value="USUARIO">Usuarios</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-600 mb-2">
                        <i class="fas fa-search me-1"></i>Filtro Rápido
                    </label>
                    <input type="text" id="filtroTabla" class="form-control form-control-sm" 
                           placeholder="Buscar en toda la tabla..." 
                           style="font-size: 0.95rem;">
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <button class="btn btn-secondary btn-sm" onclick="limpiarFiltros();" title="Limpiar todos los filtros">
                        <i class="fas fa-times me-1"></i>Limpiar Filtros
                    </button>
                    <button class="btn btn-secondary btn-sm" onclick="location.reload();" title="Refrescar datos">
                        <i class="fas fa-sync-alt me-1"></i>Refrescar
                    </button>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/web/auditoria/por-usuario/descargar" class="btn btn-success btn-sm" title="Descargar toda la auditoría por usuario en Excel">
                        <i class="fas fa-download me-1"></i>Descargar Excel
                    </a>
                    <a href="/web/auditoria" class="btn btn-primary btn-sm" title="Ver auditoría del sistema completa">
                        <i class="fas fa-arrow-left me-1"></i>Ver Auditoría General
                    </a>
                </div>
            </div>
        </div>

        <!-- Estadísticas por Usuario -->
        <div class="row mb-4" th:if="${actividades != null && !actividades.isEmpty()}">
            <div class="col-md-3">
                <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="stat-icon text-primary">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <h6 class="card-title">Novedades Reportadas</h6>
                        <p class="card-value text-primary countNovedades">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="stat-icon text-success">
                            <i class="fas fa-building"></i>
                        </div>
                        <h6 class="card-title">Laboratorios Reservados</h6>
                        <p class="card-value text-success countLaboratorios">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="stat-icon text-warning">
                            <i class="fas fa-laptop"></i>
                        </div>
                        <h6 class="card-title">Equipos</h6>
                        <p class="card-value text-warning countEquipos">0</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="stat-icon text-info">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <h6 class="card-title">Total de Actividades</h6>
                        <p class="card-value text-info countTotal">0</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Actividades -->
        <div th:if="${actividades != null && !actividades.isEmpty()}" class="table-container shadow-sm">
            <table class="table table-hover table-auditoria">
                <thead>
                    <tr>
                        <th style="width: 15%;">Fecha/Hora</th>
                        <th style="width: 12%;">Usuario</th>
                        <th style="width: 20%;">Actividad Realizada</th>
                        <th style="width: 12%;">Tipo Entidad</th>
                        <th style="width: 18%;">Nombre de Entidad</th>
                        <th style="width: 12%;">Dirección IP</th>
                        <th style="width: 11%;">Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    <tr th:each="actividad : ${actividades}">
                        <td>
                            <span class="fecha-badge" th:text="${#temporals.format(actividad.fecha, 'dd/MM/yyyy HH:mm')}">
                                --/--/---- --:--
                            </span>
                        </td>
                        <td>
                            <span class="usuario-badge" th:text="${actividad.usuario}">Usuario</span>
                        </td>
                        <td>
                            <span class="badge-activity" 
                                  th:classappend="${actividad.tipoActividad.contains('NOVEDAD') ? 'badge-novedad' : 
                                                    actividad.tipoActividad.contains('LABORATORIO') ? 'badge-laboratorio' : 
                                                    actividad.tipoActividad.contains('EQUIPO') ? 'badge-equipo' : 
                                                    'badge-usuario'}"
                                  th:text="${actividad.descripcionActividad}">
                                Actividad
                            </span>
                        </td>
                        <td>
                            <span class="entidad-badge" th:text="${actividad.tipoEntidad}">Tipo</span>
                        </td>
                        <td th:text="${actividad.nombreEntidad}" style="font-weight: 500;">Nombre de Entidad</td>
                        <td>
                            <span class="ip-badge" th:text="${actividad.ipAddress}">IP</span>
                        </td>
                        <td>
                            <small class="text-muted" th:text="${actividad.detalles}">Detalles</small>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Estado Vacío -->
        <div th:if="${actividades == null || actividades.isEmpty()}" class="table-container">
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h5 class="mt-3">No hay actividades registradas</h5>
                <p class="text-muted mt-2">
                    No se encontraron actividades de usuarios en el sistema.
                    <br>
                    <a href="/web/auditoria" class="text-decoration-none">Ver auditoría general</a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Calcular estadísticas
        document.addEventListener('DOMContentLoaded', function() {
            const filas = document.querySelectorAll('.table-auditoria tbody tr');
            let countNovedades = 0, countLaboratorios = 0, countEquipos = 0;
            
            filas.forEach(fila => {
                const texto = fila.textContent.toLowerCase();
                if (texto.includes('novedad') || texto.includes('reportó novedad')) countNovedades++;
                else if (texto.includes('laboratorio')) countLaboratorios++;
                else if (texto.includes('equipo')) countEquipos++;
            });
            
            document.querySelector('.countNovedades').textContent = countNovedades;
            document.querySelector('.countLaboratorios').textContent = countLaboratorios;
            document.querySelector('.countEquipos').textContent = countEquipos;
            document.querySelector('.countTotal').textContent = filas.length;
        });
        
        // Filtrado por usuario
        document.getElementById('filtroUsuario').addEventListener('keyup', function() {
            aplicarFiltros();
        });
        
        // Filtrado por tipo de actividad
        document.getElementById('filtroTipo').addEventListener('change', function() {
            aplicarFiltros();
        });
        
        // Filtrado en tiempo real de la tabla (búsqueda general)
        document.getElementById('filtroTabla').addEventListener('keyup', function() {
            aplicarFiltros();
        });
        
        // Función para aplicar todos los filtros
        function aplicarFiltros() {
            const filtroUsuario = document.getElementById('filtroUsuario').value.toLowerCase();
            const filtroTipo = document.getElementById('filtroTipo').value.toLowerCase();
            const filtroTabla = document.getElementById('filtroTabla').value.toLowerCase();
            
            const filas = document.querySelectorAll('.table-auditoria tbody tr');
            
            filas.forEach(fila => {
                const usuario = fila.cells[1].textContent.toLowerCase();
                const tipo = fila.cells[3].textContent.toLowerCase();
                const textoFila = fila.textContent.toLowerCase();
                
                const cumpleUsuario = usuario.includes(filtroUsuario);
                const cumpleTipo = filtroTipo === '' || tipo.includes(filtroTipo);
                const cumpleTabla = textoFila.includes(filtroTabla);
                
                if (cumpleUsuario && cumpleTipo && cumpleTabla) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }
        
        // Limpiar filtros
        function limpiarFiltros() {
            document.getElementById('filtroUsuario').value = '';
            document.getElementById('filtroTipo').value = '';
            document.getElementById('filtroTabla').value = '';
            
            const filas = document.querySelectorAll('.table-auditoria tbody tr');
            filas.forEach(fila => fila.style.display = '');
        }
    </script>
</body>
</html>
</file>

