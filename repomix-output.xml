            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main" style="max-width: 600px;">
        <div class="header-section">
            <h1><i class="fas fa-sign-out-alt me-2"></i>Registrar Salida</h1>
            <a href="/web/registros" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card mb-4" th:if="${registroActivo != null}">
            <div class="card-header">
                <i class="fas fa-info-circle me-2"></i>Registro Activo
                <span th:if="${registroActivo.tipoRegistro == 'Examen'}" class="badge badge-examen float-end">
                    <i class="fas fa-graduation-cap me-1"></i>Examen
                </span>
                <span th:if="${registroActivo.tipoRegistro == 'Normal'}" class="badge badge-normal float-end">
                    <i class="fas fa-dna me-1"></i>Uso Normal
                </span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p><strong>Laboratorio(s):</strong> <span th:text="${registroActivo.laboratorioNombre}"></span></p>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Entrada:</strong><br>
                        <span th:text="${#temporals.format(registroActivo.fechaEntrada, 'dd/MM/yyyy HH:mm')}"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Propósito:</strong><br>
                        <span th:text="${registroActivo.proposito}"></span></p>
                    </div>
                </div>
                <div th:if="${registroActivo.observaciones != null and registroActivo.observaciones != ''}">
                    <p><strong>Observaciones:</strong><br>
                    <span th:text="${registroActivo.observaciones}"></span></p>
                </div>
            </div>
        </div>

        <div class="alert alert-warning" th:if="${registroActivo == null}">
            <i class="fas fa-exclamation-triangle me-2"></i>
            No hay registro activo para cerrar.
        </div>

        <form th:if="${registroActivo != null}" th:action="@{/web/registros/salida}" th:object="${salida}" method="post">
            <div class="mb-3">
                <label class="form-label">Observaciones de Salida</label>
                <textarea class="form-control" th:field="*{observaciones}" rows="3" 
                          placeholder="Estado del laboratorio al salir, incidencias, notas..."></textarea>
            </div>

            <!-- Información adicional para exámenes -->
            <div th:if="${registroActivo.tipoRegistro == 'Examen'}" class="alert alert-info" role="alert">
                <i class="fas fa-graduation-cap me-2"></i>
                <strong>Examen en múltiples salas:</strong> 
                Al registrar la salida, cerrarás el acceso a ambas salas registradas para este examen.
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/web/registros" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-door-closed me-1"></i> Finalizar Uso
                </button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/dashboard.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema de Laboratorios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        /* ── Fondo de página ── */
        body {
            background: #f0f2f5;
        }

        /* ── Bienvenida ── */
        .welcome-card {
            background: linear-gradient(135deg, #051d33 0%, #0d3d66 60%, #1e5a96 100%);
            color: #fff;
            border-radius: 16px;
            padding: 32px 36px;
            margin-bottom: 32px;
            box-shadow: 0 8px 32px rgba(30, 90, 150, 0.35);
            position: relative;
            overflow: hidden;
        }
        .welcome-card::before {
            content: '';
            position: absolute;
            top: -40px; right: -40px;
            width: 220px; height: 220px;
            background: rgba(255,255,255,.07);
            border-radius: 50%;
        }
        .welcome-card::after {
            content: '';
            position: absolute;
            bottom: -60px; right: 80px;
            width: 160px; height: 160px;
            background: rgba(255,255,255,.05);
            border-radius: 50%;
        }
        .welcome-card h2 { font-size: 1.6rem; font-weight: 700; }
        .welcome-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.3);
            border-radius: 30px;
            padding: 4px 14px;
            font-size: .82rem;
            color: #fff;
            backdrop-filter: blur(4px);
        }

        /* ── Sección título ── */
        .section-label {
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #6c757d;
            margin-bottom: 16px;
        }

        /* ── Tarjetas de acceso rápido ── */
        .access-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            cursor: pointer;
            transition: transform .22s ease, box-shadow .22s ease;
            box-shadow: 0 4px 18px rgba(0,0,0,.12);
            height: 100%;
            position: relative;
        }
        .access-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,.2);
        }
        .access-card:active {
            transform: translateY(-2px);
        }

        /* Cuerpo de la tarjeta */
        .access-card .card-inner {
            padding: 28px 26px 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            height: 100%;
        }
        .access-card .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        .access-card .card-module {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            opacity: .8;
        }
        .access-card .card-title {
            font-size: 1.55rem;
            font-weight: 800;
            line-height: 1.15;
            margin-top: 6px;
        }
        .access-card .card-sub {
            font-size: .82rem;
            opacity: .85;
            margin-top: 2px;
        }
        .access-card .card-icon-wrap {
            width: 56px; height: 56px;
            border-radius: 14px;
            background: rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        /* Franja inferior (badge de acceso) */
        .access-card .card-footer-strip {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: .75rem;
            font-weight: 600;
            padding: 9px 26px;
            opacity: .9;
        }

        /* ── Paleta de colores por módulo ── */
        /* Laboratorios — azul primario */
        .card-laboratorios {
            background: linear-gradient(135deg, #1e5a96 0%, #0d3d66 100%);
            color: #fff;
            border-bottom: 4px solid #1e5a96;
        }
        .card-laboratorios .card-footer-strip { background: #0d3d66; }

        /* Equipos — azul acento */
        .card-equipos {
            background: linear-gradient(135deg, #2e7ca6 0%, #1e5a96 100%);
            color: #fff;
            border-bottom: 4px solid #2e7ca6;
        }
        .card-equipos .card-footer-strip { background: #1e5a96; }

        /* Novedades — azul claro */
        .card-novedades {
            background: linear-gradient(135deg, #4fa3de 0%, #2e7ca6 100%);
            color: #fff;
            border-bottom: 4px solid #4fa3de;
        }
        .card-novedades .card-footer-strip { background: #2e7ca6; }

        /* Registros — azul primario oscuro */
        .card-registros {
            background: linear-gradient(135deg, #0d3d66 0%, #051d33 100%);
            color: #fff;
            border-bottom: 4px solid #0d3d66;
        }
        .card-registros .card-footer-strip { background: #051d33; }

        /* Usuarios — azul primario light */
        .card-usuarios {
            background: linear-gradient(135deg, #1e5a96 0%, #4fa3de 100%);
            color: #fff;
            border-bottom: 4px solid #1e5a96;
        }
        .card-usuarios .card-footer-strip { background: #0d3d66; }

        /* Auditoría — gris neutral */
        .card-auditoria {
            background: linear-gradient(135deg, #051d33 0%, #0d3d66 100%);
            color: #fff;
            border-bottom: 4px solid #051d33;
        }
        .card-auditoria .card-footer-strip { background: #030d14; }

        /* ── Separador de módulos ── */
        .modules-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 32px 0 20px;
        }
        .modules-divider span {
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9e9e9e;
            white-space: nowrap;
        }
        .modules-divider::before,
        .modules-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e0e0e0;
        }

        /* ── Panel de Sesión ── */
        .session-panel {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
            overflow: hidden;
        }
        .session-panel .panel-header {
            background: linear-gradient(90deg, #263238, #37474f);
            color: #fff;
            padding: 14px 20px;
            font-weight: 600;
            font-size: .9rem;
        }
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 600;
        }
        .role-badge-admin    { background: #f3e5f5; color: #6a1b9a; }
        .role-badge-director { background: #e3f2fd; color: #1565c0; }
        .role-badge-profesor { background: #e8f5e9; color: #2e7d32; }
        .role-badge-usuario  { background: #fff3e0; color: #e65100; }

        /* ── Responsive ── */
        @media (max-width: 767px) {
            .access-card .card-title { font-size: 1.3rem; }
            .welcome-card { padding: 24px 20px; }
        }
    </style>
</head>
<body class="bg-light">
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <!-- Primera sección: Logo y usuario -->
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link active" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <div class="container-fluid py-4 px-4">

        <!-- Bienvenida -->
        <div class="welcome-card mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="mb-2 text-white"><i class="fas fa-th-large me-2"></i>Panel Principal</h2>
                    <p class="mb-0 opacity-90">
                        Bienvenido, <strong><span sec:authentication="name">Usuario</span></strong>.
                        Selecciona un módulo para comenzar.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="welcome-badge" sec:authorize="hasRole('ROLE_ADMIN')">
                        <i class="fas fa-crown"></i> Administrador
                    </span>
                    <span class="welcome-badge" sec:authorize="hasRole('FACULTAD_DIRECTOR_CARRERA')">
                        <i class="fas fa-user-tie"></i> Director
                    </span>
                    <span class="welcome-badge" sec:authorize="hasRole('PROFESOR')">
                        <i class="fas fa-chalkboard-teacher"></i> Profesor
                    </span>
                    <span class="welcome-badge" sec:authorize="hasRole('USUARIO')">
                        <i class="fas fa-user"></i> Usuario
                    </span>
                </div>
            </div>
        </div>

        <!-- Acceso Rápido — módulos principales -->
        <p class="section-label"><i class="fas fa-bolt me-1"></i>Acceso Rápido</p>
        <div class="row g-4">

            <!-- Laboratorios -->
            <div class="col-xl-4 col-md-6">
                <div class="access-card card-laboratorios" onclick="window.location='/web/laboratorios'">
                    <div class="card-inner">
                        <div class="card-top">
                            <div>
                                <div class="card-module">Laboratorios</div>
                                <div class="card-title">Gestionar</div>
                                <div class="card-sub">Ver y administrar espacios</div>
                            </div>
                            <div class="card-icon-wrap">
                                <i class="fas fa-building"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-strip">
                        <i class="fas fa-globe-americas"></i> Acceso para todos
                    </div>
                </div>
            </div>

            <!-- Equipos -->
            <div class="col-xl-4 col-md-6">
                <div class="access-card card-equipos" onclick="window.location='/web/equipos'">
                    <div class="card-inner">
                        <div class="card-top">
                            <div>
                                <div class="card-module">Equipos</div>
                                <div class="card-title">Ver Lista</div>
                                <div class="card-sub">Inventario y estados</div>
                            </div>
                            <div class="card-icon-wrap">
                                <i class="fas fa-desktop"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-strip">
                        <i class="fas fa-globe-americas"></i> Acceso para todos
                    </div>
                </div>
            </div>

            <!-- Novedades -->
            <div class="col-xl-4 col-md-6">
                <div class="access-card card-novedades" onclick="window.location='/web/novedades'">
                    <div class="card-inner">
                        <div class="card-top">
                            <div>
                                <div class="card-module">Novedades</div>
                                <div class="card-title">Reportar</div>
                                <div class="card-sub">Incidencias y avisos</div>
                            </div>
                            <div class="card-icon-wrap">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-strip">
                        <i class="fas fa-globe-americas"></i> Acceso para todos
                    </div>
                </div>
            </div>

            <!-- Registros de Uso — PROFESORES, DIRECTORES, ADMIN -->
            <div class="col-xl-4 col-md-6" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                <div class="access-card card-registros" onclick="window.location='/web/registros'">
                    <div class="card-inner">
                        <div class="card-top">
                            <div>
                                <div class="card-module">Registros de Uso</div>
                                <div class="card-title">Control</div>
                                <div class="card-sub">Entrada y salida de labs</div>
                            </div>
                            <div class="card-icon-wrap">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-strip">
                        <i class="fas fa-user-graduate"></i> Profesores y superiores
                    </div>
                </div>
            </div>

            <!-- Auditoría — DIRECTORES Y ADMIN -->
            <div class="col-xl-4 col-md-6" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                <div class="access-card card-auditoria" onclick="window.location='/web/auditoria'">
                    <div class="card-inner">
                        <div class="card-top">
                            <div>
                                <div class="card-module">Auditoría</div>
                                <div class="card-title">Historial</div>
                                <div class="card-sub">Registro de cambios</div>
                            </div>
                            <div class="card-icon-wrap">
                                <i class="fas fa-history"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer-strip">
                        <i class="fas fa-user-tie"></i> Directores y Admin
                    </div>
                </div>
            </div>

        </div><!-- /row tarjetas -->

        <!-- Panel de Sesión -->
        <div class="modules-divider"><span>Información de sesión</span></div>
        <div class="session-panel">
            <div class="panel-header">
                <i class="fas fa-shield-alt me-2"></i>Sesión Activa
            </div>
            <div class="p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-user-circle fa-2x text-secondary"></i>
                            <div>
                                <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;margin-bottom:2px">Usuario</div>
                                <strong><span sec:authentication="name" class="text-dark">N/A</span></strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px">Permisos activos</div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="role-badge role-badge-admin"    sec:authorize="hasRole('ROLE_ADMIN')"><i class="fas fa-crown"></i> Admin</span>
                            <span class="role-badge role-badge-director" sec:authorize="hasRole('FACULTAD_DIRECTOR_CARRERA')"><i class="fas fa-user-tie"></i> Director</span>
                            <span class="role-badge role-badge-profesor" sec:authorize="hasRole('PROFESOR')"><i class="fas fa-chalkboard-teacher"></i> Profesor</span>
                            <span class="role-badge role-badge-usuario"  sec:authorize="hasRole('USUARIO')"><i class="fas fa-user"></i> Usuario</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px">Estado</div>
                        <span class="badge bg-success px-3 py-2"><i class="fas fa-check-circle me-1"></i>Autenticado</span>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /container -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/laboratorios/lista.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" 
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${titulo ?: 'Laboratorios'}"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global-typography.css" rel="stylesheet">
    <link href="/css/design-system.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { padding-top: 20px; }
    </style>
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <!-- Primera sección: Logo y usuario -->
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container container-main">
            <!-- Header -->
            <div class="header-section">
                <h1><i class="fas fa-microscope me-2"></i>Gestión de Laboratorios</h1>
                <div class="d-flex gap-2">
                    <a sec:authorize="hasRole('ROLE_ADMIN')" href="/web/laboratorios/nuevo" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Nuevo Laboratorio
                    </a>
                    <a sec:authorize="hasRole('ROLE_ADMIN')" href="/web/laboratorios/eliminados" class="btn btn-outline-secondary">
                        <i class="fas fa-trash-alt me-1"></i> Ver Eliminados
                    </a>
                </div>
            </div>

            <!-- Mensaje de éxito/error -->
            <div th:if="${mensaje}" th:class="'alert alert-' + ${tipo}" role="alert">
                <span th:text="${mensaje}"></span>
            </div>

            <!-- Content -->
            <div th:if="${not #lists.isEmpty(laboratorios)}">
                <!-- Grid de laboratorios -->
                <div class="row g-4">
                    <div th:each="lab : ${laboratorios}" class="col-md-6 col-lg-4">
                        <div class="card lab-card">
                            <div class="lab-card-header">
                                <h5 class="mb-0 text-white" th:text="${lab.nombre}"></h5>
                            </div>
                            <div class="lab-card-body">
                                <!-- Ubicación -->
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-map-marker-alt"></i> Ubicación
                                    </small>
                                    <p class="mb-0" th:text="${lab.ubicacion}"></p>
                                </div>

                                <!-- Descripción -->
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i> Descripción
                                    </small>
                                    <p class="mb-0" th:text="${#strings.abbreviate(lab.descripcion, 100)}"></p>
                                </div>

                                <!-- Capacidad -->
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-users"></i> Capacidad
                                    </small>
                                    <p class="mb-0">
                                        <span th:text="${lab.capacidad}"></span> personas
                                    </p>
                                </div>

                                <!-- Estado -->
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-circle"></i> Estado
                                    </small>
                                    <p class="mb-0">
                                        <span class="lab-status" 
                                              th:classappend="${lab.activo ? 'status-activo' : 'status-inactivo'}"
                                              th:text="${lab.activo ? 'Activo' : 'Inactivo'}"></span>
                                    </p>
                                </div>

                                <!-- Acciones -->
                                <div class="action-buttons">
                                    <a th:href="@{/web/laboratorios/{id}(id=${lab.id})}" 
                                       class="btn-view">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                    <div sec:authorize="hasRole('ROLE_ADMIN')">
                                        <a th:href="@{/web/laboratorios/{id}/editar(id=${lab.id})}" 
                                           class="btn-edit" style="width: 100%;">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div th:if="${#lists.isEmpty(laboratorios)}" class="empty-state">
                <i class="fas fa-flask"></i>
                <h3>No hay laboratorios registrados</h3>
                <p>Comienza creando un nuevo laboratorio en el sistema.</p>
                <div sec:authorize="hasRole('ROLE_ADMIN')">
                    <a href="/web/laboratorios/nuevo" class="btn btn-primary mt-3">
                        <i class="fas fa-plus"></i> Crear Primer Laboratorio
                    </a>
                </div>
            </div>
    </div>

    <!-- Footer -->
    <footer class="text-center text-muted py-4 mt-5">
        <p>Sistema SIAC - Gestión de Laboratorios v1.0</p>
        <p><small>© 2026 Universidad. Todos los derechos reservados.</small></p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
