                            </span>
                            <span th:if="!${novedad.fechaResolucion}" class="text-muted">-</span>
                        </td>

                        <!-- Quién Solucionó / Observaciones de Resolución -->
                        <td>
                            <div th:if="${novedad.observacionesResolucion}">
                                <strong>Resolución:</strong>
                                <p class="mb-0 small" th:text="${#strings.abbreviate(novedad.observacionesResolucion, 100)}">Observaciones</p>
                                <small class="text-muted" th:if="${novedad.fechaResolucion}">
                                    <i class="fas fa-clock me-1"></i>
                                    <span th:text="${#temporals.format(novedad.fechaResolucion, 'dd/MM/yyyy')}">Fecha</span>
                                </small>
                            </div>
                            <span th:if="!${novedad.observacionesResolucion}" class="text-muted">-</span>
