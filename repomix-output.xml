<file path="src/main/resources/static/css/design-system.css">
/* ══ SISTEMA DE DISEÑO — Sistema de Laboratorios FING ══ */

:root {
  /* Palette Azul Profundo - Armonía Azul/Gris/Acentos */
  --color-primary-light: #4fa3de;
  --color-primary: #1e5a96;
  --color-primary-dark: #0d3d66;
  --color-deep-blue: #051d33;
  --color-nearly-black: #030d14;
  
  /* Grises Neutros - Armonía y Contraste */
  --color-bg-light: #f0f2f5;
  --color-gray-light: #e8eaed;
  --color-gray-medium: #c5cad1;
  --color-accent: #2e7ca6;
  --color-white: #ffffff;
  --color-gray-100: #f8f9fa;
  --color-gray-200: #e9ecef;
  
  /* Sombras y Elevación */
  --shadow-sm: 0 2px 4px rgba(5, 29, 51, 0.05);
  --shadow-md: 0 4px 12px rgba(5, 29, 51, 0.08);
  --shadow-lg: 0 10px 40px rgba(5, 29, 51, 0.12);
  
  /* Bordes */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
}

/* Global Background */
body {
  background-color: var(--color-bg-light);
  color: var(--color-nearly-black);
}

/* ══ COMPONENTES UI ══ */

/* Navbar Premium */
.navbar {
  background-color: var(--color-deep-blue) !important;
  box-shadow: var(--shadow-md);
  padding: 0.75rem 0;
}

.navbar-brand, .nav-link {
  color: var(--color-white) !important;
  transition: all 0.3s ease;
}

.nav-link:hover {
  color: var(--color-primary-light) !important;
  transform: translateY(-1px);
}

.nav-link.active {
  font-weight: 700;
  border-bottom: 2px solid var(--color-primary-light);
}

/* Botón de Cerrar Sesión - 3D */
.btn-logout {
  background: linear-gradient(135deg, #c5cad1 0%, #e8eaed 100%);
  border: none;
  color: #051d33;
  font-weight: 600;
  position: relative;
  box-shadow: 
    0 4px 12px rgba(5, 29, 51, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -2px 4px rgba(5, 29, 51, 0.2);
  transition: all 0.2s ease;
}

.btn-logout:hover {
  background: linear-gradient(135deg, #e8eaed 0%, #c5cad1 100%);
  transform: translateY(1px);
  box-shadow: 
    0 2px 8px rgba(5, 29, 51, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -1px 3px rgba(5, 29, 51, 0.2);
}

.btn-logout:active {
  transform: translateY(2px);
  box-shadow: 
    0 1px 4px rgba(5, 29, 51, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -1px 2px rgba(5, 29, 51, 0.15);
}

/* Page Header & Layout */
.page-header {
  background: white;
  padding: 1.5rem 0;
  margin-bottom: 2rem;
  border-bottom: 1px solid var(--color-gray-200);
}

.container-main {
  background: white;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: 2rem;
  margin-top: 1rem;
}

.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
