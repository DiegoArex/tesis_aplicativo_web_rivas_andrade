                                           class="btn-edit" style="width: 100%;">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div th:if="${#lists.isEmpty(laboratorios)}" class="empty-state">
                <i class="fas fa-flask"></i>
                <h3>No hay laboratorios registrados</h3>
                <p>Comienza creando un nuevo laboratorio en el sistema.</p>
