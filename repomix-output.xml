            <div th:if="${novedades.isEmpty()}" class="no-data">
                <i class="fas fa-inbox fa-3x mb-3" style="color: #ccc;"></i>
                <p>No hay reportes de novedades disponibles.</p>
            </div>

            <div th:if="${!novedades.isEmpty()}" class="table-responsive">
