                        <th>Usuario Reporta</th>
                        <th>Título</th>
                        <th>Descripción</th>
                        <th>Laboratorio</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Estado Actual</th>
                        <th>Fecha Resolución</th>
                        <th>Observaciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr th:each="novedad : ${novedades}" class="fila-novedad"
                        th:classappend="${'estado-' + novedad.estado}"
                        th:data-estado="${novedad.estado}"
                        th:data-prioridad="${novedad.prioridad}"
                        th:data-tipo="${novedad.tipo}">
                        
                        <!-- Fecha Reporte -->
                        <td th:text="${#temporals.format(novedad.fechaReporte, 'dd/MM/yyyy HH:mm:ss')}">
                            dd/MM/yyyy HH:mm:ss
                        </td>

                        <!-- Usuario Reporta -->
                        <td>
                            <strong th:text="${novedad.usuarioReporta.getNombreCompleto()}">Usuario</strong>
                            <br/>
                            <small class="text-muted" th:text="${'(' + novedad.usuarioReporta.getUsername() + ')'}">username</small>
                        </td>

                        <!-- Título -->
                        <td>
                            <strong th:text="${novedad.titulo}">Título</strong>
                        </td>

                        <!-- Descripción -->
                        <td>
