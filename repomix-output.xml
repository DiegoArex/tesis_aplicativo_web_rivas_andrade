/* ══ SISTEMA DE DISEÑO — Sistema de Laboratorios FING ══ */

:root {
  /* Palette Azul Profundo - Armonía Azul/Gris/Acentos */
  --color-primary-light: #4fa3de;
  --color-primary: #1e5a96;
  --color-primary-dark: #0d3d66;
  --color-deep-blue: #051d33;
  --color-nearly-black: #030d14;
  
  /* Grises Neutros - Armonía y Contraste */
  --color-bg-light: #f0f2f5;
  --color-gray-light: #e8eaed;
  --color-gray-medium: #c5cad1;
  --color-accent: #2e7ca6;
  --color-white: #ffffff;
  --color-gray-100: #f8f9fa;
  --color-gray-200: #e9ecef;
  
  /* Sombras y Elevación */
  --shadow-sm: 0 2px 4px rgba(5, 29, 51, 0.05);
  --shadow-md: 0 4px 12px rgba(5, 29, 51, 0.08);
  --shadow-lg: 0 10px 40px rgba(5, 29, 51, 0.12);
  
  /* Bordes */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
}

/* Global Background */
body {
  background-color: var(--color-bg-light);
  color: var(--color-nearly-black);
}

/* ══ COMPONENTES UI ══ */

/* Navbar Premium */
.navbar {
  background-color: var(--color-deep-blue) !important;
  box-shadow: var(--shadow-md);
  padding: 0.75rem 0;
}

.navbar-brand, .nav-link {
  color: var(--color-white) !important;
  transition: all 0.3s ease;
}

.nav-link:hover {
  color: var(--color-primary-light) !important;
  transform: translateY(-1px);
}

.nav-link.active {
  font-weight: 700;
  border-bottom: 2px solid var(--color-primary-light);
}

/* Botón de Cerrar Sesión - 3D */
.btn-logout {
  background: linear-gradient(135deg, #c5cad1 0%, #e8eaed 100%);
  border: none;
  color: #051d33;
  font-weight: 600;
  position: relative;
  box-shadow: 
    0 4px 12px rgba(5, 29, 51, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -2px 4px rgba(5, 29, 51, 0.2);
  transition: all 0.2s ease;
}

.btn-logout:hover {
  background: linear-gradient(135deg, #e8eaed 0%, #c5cad1 100%);
  transform: translateY(1px);
  box-shadow: 
    0 2px 8px rgba(5, 29, 51, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -1px 3px rgba(5, 29, 51, 0.2);
}

.btn-logout:active {
  transform: translateY(2px);
  box-shadow: 
    0 1px 4px rgba(5, 29, 51, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.6),
    0 -1px 2px rgba(5, 29, 51, 0.15);
}

/* Page Header & Layout */
.page-header {
  background: white;
  padding: 1.5rem 0;
  margin-bottom: 2rem;
  border-bottom: 1px solid var(--color-gray-200);
}

.container-main {
  background: white;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: 2rem;
  margin-top: 1rem;
}

.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  border-bottom: 2px solid var(--color-primary-light);
  padding-bottom: 1rem;
}

/* Status Badges */
.status-activo, .status-EQUIPADO, .status-RESUELTO {
  background-color: #d4edda !important;
  color: #155724 !important;
}

.status-inactivo, .status-FALTANTE, .status-PENDIENTE {
  background-color: #f8d7da !important;
  color: #721c24 !important;
}

.status-PROCESO {
  background-color: #fff3cd !important;
  color: #856404 !important;
}

/* Action Buttons Grid */
.action-buttons {
  display: flex;
  gap: 0.5rem;
  margin-top: 1rem;
}

.action-buttons a, .action-buttons button {
  flex: 1;
  text-align: center;
}

/* Botones con Gradientes */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border: none;
  border-radius: var(--radius-sm);
  padding: 0.6rem 1.5rem;
  box-shadow: 0 4px 15px rgba(5, 130, 202, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(5, 130, 202, 0.4);
  filter: brightness(1.1);
}

.btn-danger {
  background-color: #dc3545;
  border: none;
  color: white;
  box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
}

.btn-danger:hover {
  background-color: #bb2d3b;
  color: white;
  transform: translateY(-2px);
}

/* Botones de acción en tarjetas (labs) */
.btn-view, .btn-edit {
  display: inline-block;
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
  transition: all 0.2s ease;
  cursor: pointer;
  width: 100%;
}

.btn-view {
  background-color: var(--color-primary);
  color: white;
  border: 1px solid var(--color-primary);
}
.btn-view:hover {
  background-color: var(--color-primary-dark);
  color: white;
}

.btn-edit {
  background-color: #ffc107;
  color: #212529;
  border: 1px solid #ffc107;
}
.btn-edit:hover {
  background-color: #ffca2c;
  color: #212529;
}

/* Tablas */
.table {
  background: white;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.table thead th {
  background-color: var(--color-primary-dark);
  color: white;
  border: none;
  padding: 1rem;
}

.table tbody td {
  padding: 1rem;
  vertical-align: middle;
}

/* Badges */
.badge {
  padding: 0.5em 0.8em;
  border-radius: 50px;
  font-weight: 600;
}

/* ══ AJUSTES ESPECÍFICOS SOLICITADOS ══ */

/* Laboratorios - Lab Card */
.lab-card {
  border: none;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: transform 0.3s ease;
  background: white;
}

.lab-card:hover {
  transform: translateY(-5px);
}

.lab-card-header {
  background-color: var(--color-primary); /* Azul Sólido */
  color: white;
  padding: 1.25rem;
  border: none;
}

.lab-card-body {
  padding: 1.5rem;
}

/* Novedades - Estados (Texto con Color) */
.badge-estado-PENDIENTE {
  background-color: transparent !important;
  color: #6c757d !important; /* Plomo */
  border: 1px solid #dee2e6;
}

.badge-estado-EN_PROCESO {
  background-color: transparent !important;
  color: var(--color-primary) !important; /* Azul */
  border: 1px solid var(--color-primary-light);
}

.badge-estado-SOLUCIONADA {
  background-color: transparent !important;
  color: #198754 !important; /* Verde */
  border: 1px solid #a3cfbb;
}

/* Novedades - Prioridades (Fondo con Color) */
.badge-prioridad-BAJA { background-color: #0dcaf0 !important; color: #212529 !important; }
.badge-prioridad-MEDIA { background-color: #ffc107 !important; color: #212529 !important; }
.badge-prioridad-ALTA { background-color: #fd7e14 !important; color: white !important; }
.badge-prioridad-CRITICA { background-color: #dc3545 !important; color: white !important; }

/* ══ Navbar Structure (Reorganized) ══ */
/* Second navbar (light) — visual separator from page content */
nav.navbar[style*="#f8f9fa"] {
    border-bottom: 1px solid var(--color-gray-200) !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06) !important;
}

.navbar-brand {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
}

.navbar .nav-link {
    transition: all 0.2s ease;
    color: #495057 !important;
    font-weight: 500;
    border-bottom: 3px solid transparent;
}

.navbar .nav-link:hover {
    color: var(--color-primary) !important;
    border-bottom-color: var(--color-primary);
}

.navbar .nav-link.active {
    color: var(--color-primary) !important;
    border-bottom-color: var(--color-primary);
    background-color: transparent;
}

/* ══ Estado badges en tarjetas de laboratorios ══ */
.lab-status {
  display: inline-block;
  padding: 0.3em 0.75em;
  border-radius: 50px;
  font-size: 0.8rem;
  font-weight: 600;
}

/* ══ Status badges (detalle pages) ══ */
.status-badge {
  display: inline-block;
  padding: 0.35em 0.85em;
  border-radius: 50px;
  font-size: 0.82rem;
  font-weight: 600;
}
.status-active  { background-color: #d4edda; color: #155724; }
.status-inactive { background-color: #f8d7da; color: #721c24; }

/* ══ Table card wrapper (novedades, listas) ══ */
.table-card {
  background: white;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  margin-bottom: 1.5rem;
}

/* ══ Novedades tabla ══ */
.novedad-titulo {
  font-weight: 600;
  color: var(--color-primary-dark);
  text-decoration: none;
  display: block;
}
.novedad-titulo:hover {
  color: var(--color-primary-light);
  text-decoration: underline;
}
.descripcion-truncada {
  font-size: 0.78rem;
  color: #6c757d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 260px;
}

/* ══ Empty state ══ */
.empty-state {
  text-align: center;
  padding: 3rem 2rem;
  color: #6c757d;
}
.empty-state i {
  font-size: 3rem;
  margin-bottom: 1rem;
  opacity: 0.35;
  display: block;
}
.empty-state h3, .empty-state h5 {
  color: #6c757d;
  margin-bottom: 0.5rem;
}
