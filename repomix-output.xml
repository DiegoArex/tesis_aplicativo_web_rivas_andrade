        .badge-EN_PROCESO { background-color: var(--color-primary-light); color: white; }
        .badge-SOLUCIONADA{ background-color: var(--color-success, #198754); color: white; }
        .badge-BAJA    { background-color: var(--color-gray-200); color: var(--color-nearly-black); }
        .badge-MEDIA   { background-color: #ffc107; color: var(--color-nearly-black); }
        .badge-ALTA    { background-color: #fd7e14; color: white; }
        .badge-CRITICA { background-color: var(--text-danger); color: white; }
        .info-item { padding: .75rem 0; border-bottom: 1px solid var(--color-gray-200); }
        .info-item:last-child { border-bottom: none; }
        .evidence-img {
            max-height: 200px;
            object-fit: cover;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: transform 0.2s;
        }
        .evidence-img:hover { transform: scale(1.02); }
    </style>
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar navbar-expand-lg sticky-top" style="background-color: var(--color-deep-blue) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <!-- Primera sección: Logo y usuario -->
        <div class="container-fluid">
            <a class="navbar-brand" href="/web/dashboard">
                <i class="fas fa-flask me-2"></i>Sistema de Laboratorios FING
            </a>
            <div class="ms-auto d-flex align-items-center">
                <span class="text-white me-3"><i class="fas fa-user-circle me-1"></i> <strong><span sec:authentication="name">Usuario</span></strong></span>
                <form th:action="@{/logout}" method="post" class="d-inline">
                    <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
                    <button type="submit" class="btn btn-logout btn-sm"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Segunda sección: Navegación -->
    <nav class="navbar navbar-expand-lg" style="background-color: #f8f9fa !important;">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/web/dashboard"><i class="fas fa-home"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/laboratorios"><i class="fas fa-building"></i> Laboratorios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/web/equipos"><i class="fas fa-desktop"></i> Equipos</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_PROFESOR', 'ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/registros"><i class="fas fa-clipboard-list"></i> Registros</a>
                    </li>
                    <li class="nav-item"><a class="nav-link active" href="/web/novedades"><i class="fas fa-exclamation-circle"></i> Novedades</a></li>
                    <li class="nav-item" sec:authorize="hasAnyRole('ROLE_FACULTAD_DIRECTOR_CARRERA', 'ROLE_ADMIN')">
                        <a class="nav-link" href="/web/auditoria"><i class="fas fa-history"></i> Auditoría</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main">
        <div class="header-section">
            <div>
                <h1><i class="fas fa-exclamation-circle me-2 text-warning"></i>Detalle de Novedad</h1>

            </div>
            <a href="/web/novedades" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div th:if="${mensaje}" th:class="'alert alert-' + (${tipo} != null ? ${tipo} : 'info') + ' alert-dismissible fade show'" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <span th:text="${mensaje}"></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        <div th:if="${novedad == null}" class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>La novedad solicitada no existe o fue eliminada.
            <a href="/web/novedades" class="alert-link ms-2">Volver al listado</a>
        </div>

        <div th:if="${novedad != null}" class="row g-4">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-info-circle me-2"></i>Información del Reporte</span>
                        <span class="badge fs-6" th:classappend="'badge-' + ${novedad.estado?.name()}" th:text="${novedad.estado}">Estado</span>
                    </div>
                    <div class="card-body">
                        <h3 class="mb-3 text-primary" th:text="${novedad.titulo}">Título</h3>
                        <p class="lead text-secondary mb-4" th:text="${novedad.descripcion}">Descripción</p>

                        <div class="mb-4">
                            <span class="status-badge status-active me-2" th:text="'Tipo: ' + ${novedad.tipo}">Tipo</span>
                            <span class="badge p-2" th:classappend="'badge-' + ${novedad.prioridad}" th:text="'Prioridad: ' + ${novedad.prioridad}">Prioridad</span>
                        </div>

                        <div class="row bg-light p-3 rounded-3 g-3">
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="text-muted small d-block">Laboratorio</label>
                                    <span class="fw-bold"><i class="fas fa-building me-1 text-primary"></i><span th:text="${novedad.laboratorioNombre ?: 'No especificado'}"></span></span>
                                </div>
                                <div class="info-item" th:if="${novedad.equipoCodigo != null}">
                                    <label class="text-muted small d-block">Equipo</label>
                                    <span class="fw-bold"><i class="fas fa-desktop me-1 text-info"></i><span th:text="${novedad.equipoCodigo}"></span></span>
                                </div>
                                <div class="info-item">
                                    <label class="text-muted small d-block">Reportado por</label>
                                    <span class="fw-bold text-secondary"><i class="fas fa-user me-1 text-secondary"></i><span th:text="${novedad.usuarioReportaNombre ?: 'Desconocido'}"></span></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <label class="text-muted small d-block">Fecha de Reporte</label>
                                    <span class="text-secondary"><i class="fas fa-calendar-alt me-1"></i><span th:text="${novedad.fechaReporte != null ? #temporals.format(novedad.fechaReporte, 'dd/MM/yyyy HH:mm') : '-'}"></span></span>
                                </div>
                                <div class="info-item" th:if="${novedad.fechaResolucion != null}">
                                    <label class="text-muted small d-block">Fecha de Resolución</label>
                                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i><span th:text="${#temporals.format(novedad.fechaResolucion, 'dd/MM/yyyy HH:mm')}"></span></span>
                                </div>
                                <div class="info-item" th:if="${novedad.observacionesResolucion != null and !novedad.observacionesResolucion.empty}">
                                    <label class="text-muted small d-block">Resolución / Notas</label>
                                    <span class="text-secondary fst-italic" th:text="${novedad.observacionesResolucion}"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4" sec:authorize="hasAnyRole('ROLE_USUARIO', 'ROLE_ADMIN')">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-tools me-2"></i>Gestión de Novedad
                    </div>
                    <div class="card-body">
                        <form th:action="@{/web/novedades/{id}/cambiar-estado(id=${novedad.id})}" method="post" th:object="${cambiarEstadoDTO}">
                            <div class="mb-3">
                                <label class="form-label fw-bold small">Nuevo Estado</label>
                                <select class="form-select" th:field="*{nuevoEstado}" required>
                                    <option value="">-- Seleccione --</option>
                                    <option value="PENDIENTE">🕐 PENDIENTE</option>
                                    <option value="EN_PROCESO">⚙️ EN_PROCESO</option>
                                    <option value="SOLUCIONADA">✅ SOLUCIONADA</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold small">Observaciones</label>
                                <textarea class="form-control" th:field="*{observacionesResolucion}" rows="3" placeholder="Notas sobre la resolución..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Actualizar Estado</button>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <i class="fas fa-images me-2"></i>Evidencia Visual
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2" th:if="${imagenes != null and not #lists.isEmpty(imagenes)}">
                            <div class="col-6" th:each="img : ${imagenes}">
                                <div class="position-relative">
                                    <img th:src="${img.dataUri}" class="img-fluid evidence-img w-100" th:alt="${img.nombreArchivo}">
                                </div>
                            </div>
                        </div>
                        <div class="text-center py-4 text-muted" th:if="${imagenes == null or #lists.isEmpty(imagenes)}">
                            <i class="fas fa-image fa-2x mb-2 opacity-25"></i>
                            <p class="small mb-0">No hay imágenes adjuntas.</p>
                        </div>
                        
                        <hr class="my-3">
                        <form th:action="@{/web/novedades/{id}/imagen(id=${novedad.id})}" method="post" enctype="multipart/form-data" sec:authorize="hasAnyRole('ROLE_USUARIO', 'ROLE_ADMIN')">
                            <div class="mb-2">
                                <input type="file" name="archivo" class="form-control form-control-sm" accept=".jpg,.jpeg,.png" required>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                                <i class="fas fa-paperclip me-1"></i> Subir evidencia
                            </button>
                        </form>
                        <div class="alert alert-info alert-sm py-2 px-3 small mb-0" th:unless="${#authorization.expression('hasAnyRole(''ROLE_USUARIO'', ''ROLE_ADMIN'')')}">
                            <i class="fas fa-lock-alt me-1"></i>
                            <strong>Acceso restringido:</strong> Solo usuarios con rol USUARIO o ADMIN pueden subir evidencia.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
